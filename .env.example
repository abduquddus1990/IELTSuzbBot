# =====================================================================
# IELTS & CEFR Mock AI — Environment Configuration (.env.example)
# Ushbu fayldan .env nusxasini oling va o'z kalitlaringizni kiriting.
# =====================================================================

# --- 1. ILOVA VA SERVER SOZLAMALARI ---
APP_NAME="IELTS & CEFR Mock AI"
APP_ENV="development"                  # development | staging | production
DEBUG=True
SECRET_KEY="change-this-to-a-strong-random-64-char-hex-key-in-production"
HOST="0.0.0.0"
PORT=8000
BASE_WEBHOOK_URL="https://api.yourdomain.uz"
WEBAPP_URL="https://app.yourdomain.uz"

# --- 2. TELEGRAM BOT SOZLAMALARI (aiogram 3) ---
BOT_TOKEN="1234567890:AAH_your_telegram_bot_token_from_botfather"
BOT_WEBHOOK_PATH="/api/v1/webhook/telegram"
BOT_WEBHOOK_SECRET="telegram-webhook-secret-token-12345"
ADMIN_TELEGRAM_IDS="123456789,987654321"

# --- 3. MA'LUMOTLAR BAZASI (Supabase / Neon Serverless PostgreSQL) ---
# AsyncPG formatida: postgresql+asyncpg://user:password@host:port/dbname?ssl=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-forest-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- 4. AI INTEGRATSIYALARI (Google Gemini, Anthropic Claude & OpenAI Whisper) ---
GEMINI_API_KEY="AIzaSy_your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"

ANTHROPIC_API_KEY="sk-ant-api03-your_anthropic_claude_api_key_here"
# Tejamkor rejim uchun claude-3-5-haiku-latest, yuqori aniqlik uchun claude-3-5-sonnet-latest
CLAUDE_WRITING_MODEL="claude-3-5-sonnet-latest"
CLAUDE_FAST_MODEL="claude-3-5-haiku-latest"
CLAUDE_VISION_MODEL="claude-3-5-sonnet-latest"
CLAUDE_MAX_TOKENS=2500
CLAUDE_TEMPERATURE=0.1

# OpenAI Whisper (Speaking STT va zaxira GPT-4o-mini Vision OCR uchun)
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"
WHISPER_MODEL="whisper-1"
OPENAI_VISION_FALLBACK_MODEL="gpt-4o-mini"
OCR_PROVIDER="gemini"                  # gemini | claude | openai

# --- 5. CLOUDFLARE R2 STORAGE (Bepul Egress Trafik) ---
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ielts-cefr-mock-media"
R2_ENDPOINT_URL="https://your_cloudflare_account_id.r2.cloudflarestorage.com"
R2_PUBLIC_DOMAIN="https://cdn.yourdomain.uz"

# --- 6. TO'LOV TIZIMLARI (Click & Payme Merchant API) ---
# Click Merchant
CLICK_SERVICE_ID="12345"
CLICK_MERCHANT_ID="12345"
CLICK_SECRET_KEY="your_click_secret_key"
CLICK_MERCHANT_USER_ID="12345"

# Payme (Paycom) Merchant
PAYME_MERCHANT_ID="your_payme_merchant_id"
PAYME_SECRET_KEY="your_payme_production_key"
PAYME_TEST_KEY="your_payme_sandbox_test_key"
PAYME_IS_TEST=True

# --- 7. BIZNES VA TARIF NARXLARI (So'mda - UZS) ---
PRICE_FULL_MOCK_UZS=40000              # 1 ta to'liq Mock imtihon narxi (40,000 UZS)
PRICE_WRITING_ONLY_UZS=15000           # Faqat Writing tekshiruvi (15,000 UZS)
PRICE_SPEAKING_ONLY_UZS=15000          # Faqat Speaking tekshiruvi (15,000 UZS)
FREE_TRIAL_CREDITS=1                   # Ro'yxatdan o'tganda beriladigan bepul urinishlar

# --- 8. PDF HISOBOT SOZLAMALARI ---
PDF_OUTPUT_DIR="storage/reports"
PDF_DISCLAIMER_TEXT="Mustaqil AI baholash va tayyorgarlik vositasi. Ushbu hujjat rasmiy Cambridge, IDP, British Council yoki Bilimni baholash agentligi (BBA) sertifikati hisoblanmaydi."

# --- BEPUL REJIM, LIMITLAR VA REKLAMA ---
ALLOW_DEMO_AI_FALLBACK=False   # production'da doim False: AI ishlamasa soxta ball berilmaydi
DAILY_EXAM_LIMIT=2             # bir kishi uchun kuniga AI baholaydigan imtihonlar soni
DAILY_TRANSCRIBE_LIMIT=60      # Speaking javoblarini matnga o'girish (kuniga)
IP_LIMIT_MULTIPLIER=5          # bitta IP (maktab, ofis) uchun limit koeffitsiyenti
BOT_USERNAME="IELTSuzbBot"
ADSGRAM_BLOCK_ID=""            # Telegram Mini App reklamasi (https://adsgram.ai)
ADSENSE_CLIENT_ID=""           # Brauzer versiyasi uchun Google AdSense (ca-pub-...)
ADSENSE_SLOT_ID=""
